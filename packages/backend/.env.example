# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/projectapp

# JWT
JWT_SECRET=your-secret-key-min-32-chars-in-production

# Cookies
COOKIE_SECRET=your-cookie-secret
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Dex (OIDC) — defaults to JWT_SECRET if not set
# DEX_CLIENT_SECRET=your-dex-client-secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Email (SMTP) — Configure via Admin UI, or set these as optional overrides.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# One mailbox only; optional display name: Werkyn <noreply@example.com>.
# No lists, groups, comments or line breaks. Empty uses the sender fallback.
# SMTP_FROM=noreply@example.com
