{
  "name": "project-management-app",
  "private": true,
  "scripts": {
    "test": "pnpm --dir packages/shared test && node --test .github/tests/*.test.mjs && pnpm --dir packages/backend test && pnpm --dir packages/frontend test",
    "test:integration": "pnpm --filter @pm/shared build && pnpm --dir packages/backend test:integration",
    "dev": "pnpm --filter @pm/backend dev & pnpm --filter @pm/frontend dev",
    "build": "pnpm --filter @pm/shared build && pnpm --filter @pm/backend build && pnpm --filter @pm/frontend build",
    "lint": "pnpm --filter \"./packages/*\" lint",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@fastify/multipart@9.4.0>@fastify/busboy": "3.2.2",
      "@prisma/config@6.19.3>deepmerge-ts": "8.0.2",
      "readdir-glob@3.0.0>minimatch": "11.0.4",
      "@tiptap/core": "3.31.3",
      "@tiptap/pm": "3.31.3",
      "@tiptap/extensions": "3.31.3",
      "@tiptap/extension-bold": "3.31.3",
      "@tiptap/extension-bubble-menu": "3.31.3",
      "@tiptap/extension-code": "3.31.3",
      "@tiptap/extension-floating-menu": "3.31.3",
      "@tiptap/extension-horizontal-rule": "3.31.3",
      "@tiptap/extension-italic": "3.31.3",
      "@tiptap/extension-link": "3.31.3",
      "@tiptap/extension-paragraph": "3.31.3",
      "@tiptap/extension-strike": "3.31.3",
      "@tiptap/extension-text": "3.31.3",
      "@tiptap/extension-underline": "3.31.3",
      "prosemirror-transform": "1.12.4",
      "vite@6.4.5>rollup": "4.59.0",
      "ajv@8.17.1": "8.18.0",
      "@tanstack/react-router@1.159.4>srvx": "0.11.13",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.7",
      "browserslist@4.28.1": "4.28.7",
      "@babel/core@7.29.0": "7.29.6",
      "fast-copy@4.0.2": "4.1.0",
      "vitest@4.1.12>vite": "6.4.5"
    }
  }
}
