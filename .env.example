# Copy to .env and fill each secret with a separate `openssl rand -hex 32` value.
# Keep POSTGRES_PASSWORD hexadecimal so it is safe in DATABASE_URL.
JWT_SECRET=
COOKIE_SECRET=
POSTGRES_PASSWORD=

# Thumbnail decoder processes. Unset keeps one or two from the CPU count.
# Set to 1 on a small pod. See "Thumbnail memory" in the README.
# THUMBNAIL_WORKERS=1

# Local HTTP defaults. For a remote HTTPS installation, set these values:
# COOKIE_SECURE=true
# FRONTEND_URL=https://work.example.com
# CORS_ORIGIN=https://work.example.com
